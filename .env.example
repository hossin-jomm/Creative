# انسخ هذا الملف إلى .env.local واملأ القيم. لا ترفع .env.local إلى GitHub أبداً.

# --- لوحة التحكم (إلزامية) ---
ADMIN_USERNAME=
# هاش bcrypt لكلمة المرور، أنشئه بالأمر: npm run hash-password -- "كلمة المرور"
# في ملفات .env ضع الهاش بين علامتي تنصيص مفردة لأنه يحتوي على $
ADMIN_PASSWORD_HASH=
# نص عشوائي طويل (32 حرفاً على الأقل)، أنشئه بالأمر: npm run gen-secret
JWT_SECRET=

# --- Supabase (اختياري: إن لم يُضبط يعرض الموقع المعرض من data/portfolio.json) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- الموقع ---
NEXT_PUBLIC_APP_NAME=Ai Creative
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- واتساب: الرقم مكتوب في lib/siteConfig.ts (المصدر الوحيد) ---
NEXT_PUBLIC_WHATSAPP_MESSAGE=مرحباً، أريد الاستفسار عن خدماتكم
